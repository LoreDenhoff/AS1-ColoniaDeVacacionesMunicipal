# Opcional: el sistema levanta sin este archivo, con los valores por defecto del docker-compose.yml.
# Para cambiar algún valor, copiar este archivo como .env y editarlo (el .env no se sube al repo).

# Base de datos
POSTGRES_DB=colonia
POSTGRES_USER=colonia
POSTGRES_PASSWORD=colonia_demo_cambiar

# Padrón de residentes (mock)
PADRON_TIMEOUT_SECONDS=3

# Temporada de la colonia
TEMPORADA=2027

# Keycloak
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin_demo_cambiar
